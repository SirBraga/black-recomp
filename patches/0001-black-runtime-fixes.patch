     if (!expect(!emittedUnhandledSeek,
                 "sceCdSeek still emitted an unhandled IOP import")) return 1;
 
+    // IOP RAM is one sysmem-like pool: freed blocks are reused (first fit), and the pool
+    // covers well over 1 MB (Black asks for 34 x 32 KB stream buffers plus its banks).
+    iop.reset();
+    {
+        const uint32_t first = iop.allocateMemory(0x8000u);
+        const uint32_t second = iop.allocateMemory(0x8000u);
+        if (!expect(first != 0u && second != 0u && first != second,
+                    "IOP pool could not hand out two 32 KB blocks")) return 1;
+        if (!expect(iop.freeMemory(first), "IOP pool did not release a live block")) return 1;
+        if (!expect(iop.allocateMemory(0x8000u) == first,
+                    "IOP pool did not reuse the lowest freed block")) return 1;
+        bool cycled = true;
+        for (int i = 0; i < 256 && cycled; ++i)
+        {
+            const uint32_t transient = iop.allocateMemory(0x10000u, 64u);
+            cycled = transient != 0u && iop.freeMemory(transient);
+        }
+        if (!expect(cycled, "Repeated 64 KB alloc/free exhausted the IOP pool")) return 1;
+        std::vector<uint32_t> streamBuffers;
+        for (int i = 0; i < 34; ++i)
+            streamBuffers.push_back(iop.allocateMemory(0x8000u));
+        if (!expect(std::none_of(streamBuffers.begin(), streamBuffers.end(), [](uint32_t a) { return a == 0u; }),
+                    "IOP pool could not hold 34 x 32 KB stream buffers")) return 1;
+        if (!expect(iop.allocateMemory(0x10000u, 64u) != 0u,
