+        uint32_t outEnd = dmaOut.armed ? dmaOut.addr + dmaOut.blockWords * 4u * dmaOut.blocks : dmaOut.addr;
+        inEnd = std::min(inEnd, iopRamSize);
+        outEnd = std::min(outEnd, iopRamSize);
+        const uint32_t inBlock = dmaIn.blockWords * 4u;
+        const uint32_t outBlock = dmaOut.blockWords * 4u;
+
+        uint32_t recv1 = kRecv1Connected;
+        bool any = false;
+        std::vector<uint8_t> cmd;
+        std::vector<uint8_t> reply;
+
+        for (size_t entry = 0; entry < m_send3.size(); ++entry)
+        {
+            const uint32_t send3 = m_send3[entry];
+            if (send3 == 0u)
+                break;
+            const int port = static_cast<int>(send3 & 3u);
+            const uint32_t inLen = (send3 >> 8u) & 0x1FFu;
+            const uint32_t outLen = (send3 >> 18u) & 0x1FFu;
+
+            cmd.clear();
+            if (dmaIn.armed && inCursor < inEnd)
+            {
+                const uint32_t take = std::min(inLen, inEnd - inCursor);
+                cmd.assign(iopRam + inCursor, iopRam + inCursor + take);
+                const uint32_t consumed = inBlock ? ((inLen + inBlock - 1u) / inBlock) * inBlock : inLen;
+                inCursor = std::min(inEnd, inCursor + std::max(consumed, inBlock));
+            }
+            else
+            {
+                for (uint32_t i = 0; i < inLen && !m_fifoIn.empty(); ++i)
+                {
+                    cmd.push_back(m_fifoIn.front());
+                    m_fifoIn.pop_front();
+                }
+            }
+            cmd.resize(inLen, 0u);
+
+            reply.clear();
+            // A zero-length slot clocks no bytes: the status only reflects whether something is
+            // attached to the port (controllers on 0/1, memory cards on 2/3).
+            const bool answered = inLen == 0u ? devicePresent(port) : processCommand(port, cmd, reply);
+            any = true;
+            // The status of the last queued command is what RECV1 reports.
+            recv1 = answered ? kRecv1Connected : (kRecv1NoDevice | (0x10000u << port));
+            reply.resize(std::max<size_t>(reply.size(), outLen), answered ? 0x00u : 0xFFu);
+            reply.resize(outLen);
+
+            if (traceEnabled())
+            {
+                char tag[64];
+                std::snprintf(tag, sizeof(tag), "cmd s3=%08x %s", send3, dmaIn.armed ? "dma" : "pio");
+                traceBytes(tag, port, cmd.data(), cmd.size());
+                std::snprintf(tag, sizeof(tag), "rep %s%s", answered ? "ok" : "nodev", dmaOut.armed ? " dma" : " pio");
+                traceBytes(tag, port, reply.data(), reply.size());
+            }
+
+            if (dmaOut.armed && outCursor < outEnd)
+            {
+                const uint32_t span = outBlock ? ((outLen + outBlock - 1u) / outBlock) * outBlock : outLen;
+                const uint32_t room = std::min(std::max(span, outBlock), outEnd - outCursor);
+                std::memset(iopRam + outCursor, 0, room);
+                std::memcpy(iopRam + outCursor, reply.data(), std::min<uint32_t>(room, static_cast<uint32_t>(reply.size())));
+                if (notifyWrite)
+                    notifyWrite(outCursor, room);
+                outCursor += room;
+            }
+            else
+            {
+                m_fifoOut.insert(m_fifoOut.end(), reply.begin(), reply.end());
+            }
+        }
+
+        dmaIn.armed = false;
+        dmaOut.armed = false;
+        if (any)
+            m_recv1 = recv1;
+        if (traceEnabled())
+            std::fprintf(stderr, "[sio2] xfer end recv1=%05x\n", m_recv1);
+        m_recv2 = 0xFu;
+        m_recv3 = 0u;
+    }
+
+    bool IopSio2::devicePresent(int port)
+    {
+        if (port < 2)
+        {
+            uint8_t state[32];
+            return m_padReader && m_padReader(port, state);
+        }
+        return ensureCard(port & 1);
+    }
+
+    bool IopSio2::processCommand(int port, const std::vector<uint8_t> &cmd, std::vector<uint8_t> &reply)
+    {
+        if (cmd.empty())
+            return false;
+        // Ports 0/1 carry the controller connectors, 2/3 the memory card slots.
+        const int slot = port & 1;
+        switch (cmd[0])
+        {
+        case kDevPad:
+            return port < 2 && padCommand(slot, cmd, reply);
+        case kDevMemcard:
+            return cardCommand(slot, cmd, reply);
+        case kDevMultitap:
+        case kDevInfrared:
+        default:
+            return false;
+        }
+    }
+
+    bool IopSio2::padCommand(int port, const std::vector<uint8_t> &cmd, std::vector<uint8_t> &reply)
+    {
+        uint8_t host[32];
+        std::memset(host, 0, sizeof(host));
+        if (!m_padReader || !m_padReader(port, host))
+            return false;
+
+        PadState &pad = m_pads[static_cast<size_t>(port)];
+        const uint8_t command = cmd.size() > 1 ? cmd[1] : 0u;
+        auto arg = [&cmd](size_t i) -> uint8_t
+        { return i + 3u < cmd.size() ? cmd[i + 3u] : 0u; };
+
+        const bool inConfig = pad.config;
+        reply.push_back(0xFFu);
+        reply.push_back(inConfig ? 0xF3u : pad.mode);
+        reply.push_back(0x5Au);
+
+        auto pushData = [&]()
+        {
+            reply.push_back(host[2]);
+            reply.push_back(host[3]);
+            if (inConfig)
+            {
+                // Config mode (0xF3) reports three halfwords: buttons plus the right stick.
+                reply.push_back(host[4]);
+                reply.push_back(host[5]);
+                reply.push_back(host[6]);
+                reply.push_back(host[7]);
+                return;
+            }
+            if (pad.mode == 0x41u)
+                return;
+            reply.push_back(host[4]);
+            reply.push_back(host[5]);
+            reply.push_back(host[6]);
+            reply.push_back(host[7]);
+            if (pad.mode != 0x79u)
+                return;
+            // Pressure bytes: right, left, up, down, triangle, circle, cross, square, L1, R1, L2, R2.
+            const uint16_t buttons = static_cast<uint16_t>(host[2] | (host[3] << 8));
+            static constexpr uint16_t kOrder[12] = {0x0020u, 0x0080u, 0x0010u, 0x0040u, 0x1000u, 0x2000u,
+                                                    0x4000u, 0x8000u, 0x0400u, 0x0800u, 0x0100u, 0x0200u};
+            for (int i = 0; i < 12; ++i)
+            {
+                const bool enabled = (pad.pressureMask >> (i + 6)) & 1u;
+                reply.push_back((enabled && (buttons & kOrder[i]) == 0u) ? 0xFFu : 0x00u);
+            }
+        };
+        auto pushConfig = [&](std::initializer_list<uint8_t> bytes)
+        {
+            reply.insert(reply.end(), bytes.begin(), bytes.end());
+        };
+
+        switch (command)
+        {
+        case 0x40: // set VREF parameter
+            pushConfig({0x00, 0x00, 0x02, 0x00, 0x00, 0x5A});
+            break;
+        case 0x41: // query button mask
+            if (pad.mode == 0x41u && !inConfig)
+                pushConfig({0x00, 0x00, 0x00, 0x00, 0x00, 0x00});
+            else
+                pushConfig({0xFF, 0xFF, 0x03, 0x00, 0x00, 0x5A});
+            break;
+        case 0x42: // read data (answered in config mode too)
+            pushData();
+            break;
+        case 0x43: // enter/exit config
+            if (inConfig)
+                pushConfig({0x00, 0x00, 0x00, 0x00, 0x00, 0x00});
+            else
+                pushData();
+            pad.config = arg(0) == 0x01u;
+            break;
+        case 0x44: // set main mode (config only)
+            if (inConfig)
+            {
+                pad.mode = arg(0) == 0x01u ? 0x73u : 0x41u;
+                pad.modeLocked = arg(1) == 0x03u;
+            }
+            pushConfig({0x00, 0x00, 0x00, 0x00, 0x00, 0x00});
+            break;
+        case 0x45: // query model and mode
+            pushConfig({0x03, 0x02, static_cast<uint8_t>(pad.mode == 0x41u ? 0x00u : 0x01u), 0x02, 0x01, 0x00});
+            break;
+        case 0x46: // query act
+            if (arg(0) == 0x00u)
+                pushConfig({0x00, 0x00, 0x01, 0x02, 0x00, 0x0A});
+            else
+                pushConfig({0x00, 0x00, 0x01, 0x01, 0x01, 0x14});
+            break;
+        case 0x47: // query comb
+            pushConfig({0x00, 0x00, 0x02, 0x00, 0x01, 0x00});
+            break;
+        case 0x4C: // query mode
+            if (arg(0) == 0x00u)
+                pushConfig({0x00, 0x00, 0x00, 0x04, 0x00, 0x00});
+            else
+                pushConfig({0x00, 0x00, 0x00, 0x07, 0x00, 0x00});
+            break;
+        case 0x4D: // vibration mapping
+            for (size_t i = 0; i < pad.vibrationMap.size(); ++i)
+            {
+                reply.push_back(pad.vibrationMap[i]);
+                pad.vibrationMap[i] = arg(i);
+            }
+            break;
+        case 0x4F: // set DS2 native mode (pressure buttons)
+            if (inConfig)
+            {
+                pad.mode = 0x79u;
+                pad.pressureMask = static_cast<uint32_t>(arg(0)) | (static_cast<uint32_t>(arg(1)) << 8u) |
+                                   (static_cast<uint32_t>(arg(2) & 0x03u) << 16u);
+            }
+            pushConfig({0x00, 0x00, 0x00, 0x00, 0x00, 0x5A});
+            break;
+        default:
+            pushConfig({0x00, 0x00, 0x00, 0x00, 0x00, 0x00});
+            break;
+        }
+        return true;
+    }
+
+    bool IopSio2::ensureCard(int port)
+    {
+        Card &card = m_cards[static_cast<size_t>(port)];
+        if (card.loaded)
+            return !card.image.empty();
+        card.loaded = true;
+        card.term = kCardDefaultTerm;
+        card.path = m_cardPath ? m_cardPath(port) : std::string{};
+        if (card.path.empty())
+            return false;
+
+        const size_t size = static_cast<size_t>(kCardPageRaw) * kCardPages;
+        card.image.assign(size, 0xFFu); // erased flash = unformatted card
+        std::error_code ec;
+        const std::filesystem::path path{card.path};
+        if (std::filesystem::exists(path, ec))
+        {
+            std::ifstream in(path, std::ios::binary);
+            in.read(reinterpret_cast<char *>(card.image.data()), static_cast<std::streamsize>(size));
+        }
+        else
+        {
+            std::filesystem::create_directories(path.parent_path(), ec);
+            card.dirty = true;
+            flushCard(port);
+        }
+        return true;
+    }
+
+    void IopSio2::flushCard(int port)
+    {
+        Card &card = m_cards[static_cast<size_t>(port)];
+        if (!card.dirty || card.path.empty() || card.image.empty())
+            return;
+        std::ofstream out(card.path, std::ios::binary | std::ios::trunc);
+        out.write(reinterpret_cast<const char *>(card.image.data()), static_cast<std::streamsize>(card.image.size()));
+        card.dirty = false;
+    }
+
+    bool IopSio2::cardCommand(int port, const std::vector<uint8_t> &cmd, std::vector<uint8_t> &reply)
+    {
+        if (!ensureCard(port))
+            return false;
+        Card &card = m_cards[static_cast<size_t>(port)];
+        size_t pos = 2u;
+        auto next = [&cmd, &pos]() -> uint8_t
+        { return pos < cmd.size() ? cmd[pos++] : 0u; };
+        // Zero-pads up to `length - 2` and ends with 0x2B + terminator (the common reply shape).
+        auto terminate = [&reply, &card](size_t length)
+        {
+            while (reply.size() + 2u < length)
+                reply.push_back(0x00u);
+            reply.push_back(0x2Bu);
+            reply.push_back(card.term);
+        };
+
+        reply.push_back(0xFFu); // reply to the 0x81 device byte
+        reply.push_back(0xFFu); // reply to the command byte
+        const uint8_t command = cmd.size() > 1 ? cmd[1] : 0u;
+        switch (command)
+        {
+        case 0x11: // probe
+        case 0x12: // write/delete end
+        case 0x81: // read/write end
+            terminate(4);
+            break;
+        case 0x21: // set erase sector
+        case 0x22: // set write sector
+        case 0x23: // set read sector
+        {
+            const uint32_t b0 = next(), b1 = next(), b2 = next(), b3 = next();
+            (void)next(); // checksum (b0^b1^b2^b3)
+            card.sector = b0 | (b1 << 8u) | (b2 << 16u) | (b3 << 24u);
+            card.offset = 0u;
+            terminate(9);
+            break;
+        }
+        case 0x26: // get specs
+        {
+            const uint8_t spec[8] = {
+                static_cast<uint8_t>(kCardPageData & 0xFFu), static_cast<uint8_t>(kCardPageData >> 8u),
+                static_cast<uint8_t>(kCardEraseBlock & 0xFFu), static_cast<uint8_t>(kCardEraseBlock >> 8u),
+                static_cast<uint8_t>(kCardPages & 0xFFu), static_cast<uint8_t>((kCardPages >> 8u) & 0xFFu),
+                static_cast<uint8_t>((kCardPages >> 16u) & 0xFFu), static_cast<uint8_t>(kCardPages >> 24u)};
+            uint8_t checksum = 0u;
+            reply.push_back(0x2Bu);
+            for (uint8_t b : spec)
+            {
+                checksum ^= b;
+                reply.push_back(b);
+            }
+            reply.push_back(checksum);
+            reply.push_back(card.term);
+            break;
+        }
+        case 0x27: // set terminator
+        {
+            const uint8_t old = card.term;
+            card.term = next();
+            reply.push_back(0x00u);
+            reply.push_back(0x2Bu);
+            reply.push_back(old);
+            break;
+        }
+        case 0x28: // get terminator
+            reply.push_back(0x2Bu);
+            reply.push_back(card.term);
+            reply.push_back(kCardDefaultTerm);
+            break;
+        case 0x42: // write data
+        {
+            const uint8_t length = next();
+            reply.push_back(0x00u);
+            reply.push_back(0x2Bu);
+            uint8_t checksum = 0u;
+            const size_t base = static_cast<size_t>(card.sector) * kCardPageRaw + card.offset;
+            for (uint32_t i = 0; i < length; ++i)
+            {
+                const uint8_t b = next();
+                checksum ^= b;
+                // NAND programming can only clear bits.
+                if (card.sector < kCardPages && base + i < card.image.size())
+                    card.image[base + i] &= b;
+                reply.push_back(0x00u);
+            }
+            card.offset += length;
+            card.dirty = true;
+            reply.push_back(checksum);
+            reply.push_back(card.term);
+            break;
+        }
+        case 0x43: // read data
+        {
+            const uint8_t length = next();
+            reply.push_back(0x00u);
+            reply.push_back(0x2Bu);
+            uint8_t checksum = 0u;
+            const size_t base = static_cast<size_t>(card.sector) * kCardPageRaw + card.offset;
+            for (uint32_t i = 0; i < length; ++i)
+            {
+                const uint8_t b = (card.sector < kCardPages && base + i < card.image.size()) ? card.image[base + i] : 0xFFu;
+                checksum ^= b;
+                reply.push_back(b);
+            }
+            card.offset += length;
+            reply.push_back(checksum);
+            reply.push_back(card.term);
+            break;
+        }
+        case 0x82: // erase block
+        {
+            const uint32_t first = card.sector & ~(kCardEraseBlock - 1u);
+            if (first < kCardPages)
+            {
+                std::fill_n(card.image.begin() + static_cast<std::ptrdiff_t>(first) * kCardPageRaw,
+                            static_cast<size_t>(kCardEraseBlock) * kCardPageRaw, uint8_t{0xFFu});
+                card.dirty = true;
+            }
+            terminate(4);
+            break;
+        }
+        case 0xBF: // boot-time query
+            terminate(5);
+            break;
+        case 0xF0: // authentication (xor exchanges)
+        case 0xF1:
+        case 0xF2:
+        {
+            const uint8_t mode = next();
+            switch (mode)
+            {
+            case 0x01: case 0x02: case 0x04: case 0x0F: case 0x11: case 0x13:
+            {
+                reply.push_back(0x00u);
+                reply.push_back(0x2Bu);
+                uint8_t x = 0u;
+                for (int i = 0; i < 8; ++i)
+                {
+                    x ^= next();
+                    reply.push_back(0x00u);
+                }
+                reply.push_back(x);
+                reply.push_back(card.term);
+                break;
+            }
+            case 0x06: case 0x07: case 0x0B:
+                terminate(14);
+                break;
+            default:
+                terminate(5);
+                break;
+            }
+            break;
+        }
+        case 0xF3:
+        case 0xF7:
+            terminate(5);
+            break;
+        default:
+            if (traceEnabled())
+                std::fprintf(stderr, "[sio2] unknown memcard command 0x%02x\n", command);
+            terminate(4);
+            break;
+        }
+
+        // Commit finished writes so a crash never loses a completed save.
+        if (command == 0x81 || command == 0x12 || command == 0x82)
+            flushCard(port);
+        return true;
+    }
+}
diff --git a/ps2xIOP/src/emulator/core/iop_sio2.h b/ps2xIOP/src/emulator/core/iop_sio2.h
new file mode 100644
index 0000000..0949814
--- /dev/null
+++ b/ps2xIOP/src/emulator/core/iop_sio2.h
@@ -0,0 +1,117 @@
+#pragma once
+// SIO2 controller + attached serial devices for the ps2xIOP emulator.
+//
+// Real IOP drivers (SIO2MAN.IRX and everything layered on it: PADMAN/DBCMAN/DS2O,
+// MCMAN/MC2_D, ...) talk to the SIO2 block at 0x1F808200. This models what they see:
+//   - SEND3[16] transfer queue, SEND1/SEND2 port parameters, CTRL, RECV1..3, ISTAT
+//   - byte FIFOs (PIO) and the SIO2in/SIO2out DMA channels (IOP DMA 11/12)
+//   - a transfer completion interrupt (IOP irq 17)
+//   - devices selected by the first command byte: DualShock 2 (0x01) and
+//     PS2 memory card (0x81) on the two physical ports.
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <deque>
+#include <functional>
+#include <string>
+#include <vector>
+
+namespace ps2x::iop::detail
+{
+    class IopSio2
+    {
+    public:
+        static constexpr uint32_t RegBase = 0x1F808200u;
+        static constexpr uint32_t RegEnd = 0x1F808300u;
+        static constexpr int Irq = 17;
+
+        struct DmaRequest
+        {
+            uint32_t addr = 0;
+            uint32_t blockWords = 0;
+            uint32_t blocks = 0;
+            bool armed = false;
+        };
+
+        // 32-byte DualShock2 state like the runtime pad backend reports it:
+        // [2..3] buttons (active low), [4..7] rx, ry, lx, ly.
+        using PadReader = std::function<bool(int port, uint8_t *state32)>;
+        // Memory card backing store: returns the path of the image for a port, "" = no card.
+        using CardPath = std::function<std::string(int port)>;
+
+        IopSio2();
+        void reset();
+        void setPadReader(PadReader reader) { m_padReader = std::move(reader); }
+        void setCardPath(CardPath path) { m_cardPath = std::move(path); }
+        // True when a memory card is inserted in slot `port` (0/1).
+        [[nodiscard]] bool cardPresent(int port) { return port >= 0 && port < 2 && ensureCard(port); }
+
+        [[nodiscard]] static bool isRegister(uint32_t phys) noexcept { return phys >= RegBase && phys < RegEnd; }
+        [[nodiscard]] uint32_t read32(uint32_t phys);
+        void write32(uint32_t phys, uint32_t value);
+        [[nodiscard]] uint8_t read8(uint32_t phys);
+        void write8(uint32_t phys, uint8_t value);
+
+        // IOP DMA channel 11 (in) / 12 (out) requests issued through dmacman.
+        void setDma(int channel, uint32_t addr, uint32_t blockWords, uint32_t blocks);
+        void kickDma(int channel);
+
+        // Called for every IOP RAM range written by the SIO2out DMA.
+        using WriteNotifier = std::function<void(uint32_t addr, uint32_t size)>;
+
+        // Performs a transfer started through CTRL bit0 against IOP RAM and latches the
+        // completion interrupt.
+        void service(uint8_t *iopRam, uint32_t iopRamSize, const WriteNotifier &notifyWrite);
+        [[nodiscard]] bool takeIrq() noexcept;
+
+    private:
+        struct PadState
+        {
+            uint8_t mode = 0x41;        // 0x41 digital, 0x73 analog, 0x79 analog+pressure
+            bool config = false;
+            bool modeLocked = false;
+            std::array<uint8_t, 6> vibrationMap{0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF};
+            uint32_t pressureMask = 0x3FFFFu;
+        };
+
+        struct Card
+        {
+            bool loaded = false;
+            std::string path;
+            std::vector<uint8_t> image; // raw, 528 bytes per page (512 data + 16 ECC)
+            uint32_t sector = 0;
+            uint32_t offset = 0;
+            uint8_t term = 0x55;
+            bool dirty = false;
+        };
+
+        void transfer(uint8_t *iopRam, uint32_t iopRamSize, const WriteNotifier &notifyWrite);
+        bool devicePresent(int port);
+        bool processCommand(int port, const std::vector<uint8_t> &cmd, std::vector<uint8_t> &reply);
+        bool padCommand(int port, const std::vector<uint8_t> &cmd, std::vector<uint8_t> &reply);
+        bool cardCommand(int port, const std::vector<uint8_t> &cmd, std::vector<uint8_t> &reply);
+        bool ensureCard(int port);
+        void flushCard(int port);
+
+        std::array<uint32_t, 16> m_send3{};
+        std::array<uint32_t, 4> m_send1{};
+        std::array<uint32_t, 4> m_send2{};
+        uint32_t m_ctrl = 0;
+        uint32_t m_recv1 = 0x1D100u;
+        uint32_t m_recv2 = 0xFu;
+        uint32_t m_recv3 = 0;
+        uint32_t m_reg278 = 0;
+        uint32_t m_reg27c = 0;
+        uint32_t m_istat = 0;
+        std::deque<uint8_t> m_fifoIn;
+        std::deque<uint8_t> m_fifoOut;
+        std::array<DmaRequest, 2> m_dma{}; // [0] = ch11 in, [1] = ch12 out
+        bool m_startPending = false;
+        bool m_irqPending = false;
+
+        std::array<PadState, 2> m_pads{};
+        std::array<Card, 2> m_cards{};
+        PadReader m_padReader;
+        CardPath m_cardPath;
+    };
+}
diff --git a/ps2xIOP/src/emulator/core/iop_spu2.cpp b/ps2xIOP/src/emulator/core/iop_spu2.cpp
new file mode 100644
index 0000000..ac64a63
--- /dev/null
+++ b/ps2xIOP/src/emulator/core/iop_spu2.cpp
@@ -0,0 +1,498 @@
+#include "iop_spu2.h"
+
+#include <algorithm>
+#include <cstring>
+#include <cstdio>
+#include <cstdlib>
+
+namespace ps2x::iop::detail
+{
+    namespace
+    {
+        bool spuTrace()
+        {
+            static const bool enabled = std::getenv("PS2X_SPU_TRACE") != nullptr;
+            return enabled;
+        }
+        unsigned g_spuLogBudget = 400u;
+#define SPU_LOG(...)                                   \
+    do                                                 \
+    {                                                  \
+        if (spuTrace() && g_spuLogBudget)              \
+        {                                              \
+            --g_spuLogBudget;                          \
+            std::fprintf(stderr, "[spu2] " __VA_ARGS__); \
+        }                                              \
+    } while (0)
+        // Per-core register offsets (core 1 = +0x400).
+        constexpr uint32_t kRegAttr = 0x19Au;
+        constexpr uint32_t kRegIrqaHi = 0x19Cu;
+        constexpr uint32_t kRegKonLo = 0x1A0u;  // voices 0..15
+        constexpr uint32_t kRegKonHi = 0x1A2u;  // voices 16..23
+        constexpr uint32_t kRegKoffLo = 0x1A4u;
+        constexpr uint32_t kRegKoffHi = 0x1A6u;
+        constexpr uint32_t kRegTsaHi = 0x1A8u;
+        constexpr uint32_t kRegTsaLo = 0x1AAu;
+        constexpr uint32_t kRegStd = 0x1ACu;
+        constexpr uint32_t kRegEndxLo = 0x340u;
+        constexpr uint32_t kRegEndxHi = 0x342u;
+        constexpr uint32_t kRegStatx = 0x344u;
+        // Global registers.
+        constexpr uint32_t kRegIrqInfo = 0x7C2u;
+
+        // Voice address block (0x1C0 + v*0xC): SSA, LSAX, NAX as hi/lo pairs.
+        constexpr uint32_t kVoiceSsa = 0x0u;
+        constexpr uint32_t kVoiceLsax = 0x4u;
+        constexpr uint32_t kVoiceNax = 0x8u;
+        // Voice parameter block (v*0x10).
+        constexpr uint32_t kVoicePitch = 0x4u;
+        constexpr uint32_t kVoiceAdsr1 = 0x6u;
+        constexpr uint32_t kVoiceAdsr2 = 0x8u;
+        constexpr uint32_t kVoiceEnvx = 0xAu;
+
+        constexpr uint32_t kSamplesPerBlock = 28u;
+        constexpr uint32_t kBlockHalfwords = 8u;
+        constexpr int32_t kEnvMax = 0x7FFF;
+
+        struct EnvRate
+        {
+            int shift;
+            int step;
+            bool decrease;
+            bool exponential;
+        };
+
+        // PSX/PS2 SPU envelope rate: 7-bit rate = shift<<2 | stepIndex.
+        EnvRate makeRate(uint32_t rate, bool decrease, bool exponential)
+        {
+            EnvRate r{};
+            r.shift = static_cast<int>(rate >> 2);
+            r.step = decrease ? (-8 + static_cast<int>(rate & 3u)) : (7 - static_cast<int>(rate & 3u));
+            r.decrease = decrease;
+            r.exponential = exponential;
+            return r;
+        }
+    }
+
+    IopSpu2::IopSpu2()
+        : m_ram(RamHalfwords, 0u)
+    {
+        reset();
+    }
+
+    void IopSpu2::reset()
+    {
+        std::fill(m_ram.begin(), m_ram.end(), uint16_t{0});
+        m_regs.fill(0u);
+        for (auto &core : m_voices)
+            core.fill(Voice{});
+        m_tsa.fill(0u);
+        m_endx.fill(0u);
+        m_irqInfo = 0u;
+        m_irqPending = false;
+        m_outPos = 0u;
+        m_lastCycle = 0u;
+        m_cycleCarry = 0u;
+    }
+
+    uint32_t IopSpu2::readAddr(uint32_t hiOffset) const
+    {
+        return ((static_cast<uint32_t>(regv(hiOffset)) & 0xFu) << 16u | regv(hiOffset + 2u)) & AddressMask;
+    }
+
+    void IopSpu2::writeAddr(uint32_t hiOffset, uint32_t value)
+    {
+        value &= AddressMask;
+        reg(hiOffset) = static_cast<uint16_t>(value >> 16u);
+        reg(hiOffset + 2u) = static_cast<uint16_t>(value & 0xFFFFu);
+    }
+
+    uint16_t IopSpu2::read16(uint32_t phys)
+    {
+        const uint32_t offset = (phys - RegBase) & (RegSize - 2u);
+        if (offset == kRegIrqInfo)
+        {
+            // SPDIF_IRQINFO is cleared by reading; LIBSD's handler loops until it reads 0.
+            const uint16_t value = m_irqInfo;
+            m_irqInfo = 0u;
+            return value;
+        }
+        if (offset < 0x760u)
+        {
+            const int core = offset >= 0x400u ? 1 : 0;
+            const uint32_t local = offset - core * 0x400u;
+            if (local == kRegEndxLo)
+                return static_cast<uint16_t>(m_endx[core] & 0xFFFFu);
+            if (local == kRegEndxHi)
+                return static_cast<uint16_t>(m_endx[core] >> 16u);
+            if (local == kRegTsaHi)
+                return static_cast<uint16_t>(m_tsa[core] >> 16u);
+            if (local == kRegTsaLo)
+                return static_cast<uint16_t>(m_tsa[core] & 0xFFFFu);
+            if (local < 0x180u && (local & 0xFu) == kVoiceEnvx)
+                return static_cast<uint16_t>(m_voices[core][local >> 4u].env);
+            if (local >= 0x1C0u && local < 0x1C0u + Voices * 0xCu)
+            {
+                const uint32_t rel = local - 0x1C0u;
+                const Voice &v = m_voices[core][rel / 0xCu];
+                const uint32_t field = rel % 0xCu;
+                if (field == kVoiceNax)
+                    return static_cast<uint16_t>(v.nax >> 16u);
+                if (field == kVoiceNax + 2u)
+                    return static_cast<uint16_t>(v.nax & 0xFFFFu);
+                if (field == kVoiceLsax)
+                    return static_cast<uint16_t>(v.lsax >> 16u);
+                if (field == kVoiceLsax + 2u)
+                    return static_cast<uint16_t>(v.lsax & 0xFFFFu);
+            }
+        }
+        return regv(offset);
+    }
+
+    void IopSpu2::write16(uint32_t phys, uint16_t value)
+    {
+        const uint32_t offset = (phys - RegBase) & (RegSize - 2u);
+        if (offset == kRegIrqInfo)
+        {
+            m_irqInfo = 0u;
+            return;
+        }
+        if (offset >= 0x760u)
+        {
+            reg(offset) = value;
+            return;
+        }
+
+        const int core = offset >= 0x400u ? 1 : 0;
+        const uint32_t local = offset - core * 0x400u;
+
+        switch (local)
+        {
+        case kRegKonLo:
+        case kRegKonHi:
+        {
+            reg(offset) = value;
+            const int first = local == kRegKonLo ? 0 : 16;
+            for (int i = 0; i < 16 && first + i < Voices; ++i)
+                if (value & (1u << i))
+                    keyOn(core, first + i);
+            return;
+        }
+        case kRegKoffLo:
+        case kRegKoffHi:
+        {
+            reg(offset) = value;
+            const int first = local == kRegKoffLo ? 0 : 16;
+            for (int i = 0; i < 16 && first + i < Voices; ++i)
+                if (value & (1u << i))
+                    keyOff(core, first + i);
+            return;
+        }
+        case kRegTsaHi:
+            m_tsa[core] = ((static_cast<uint32_t>(value) & 0xFu) << 16u | (m_tsa[core] & 0xFFFFu)) & AddressMask;
+            reg(offset) = value;
+            return;
+        case kRegTsaLo:
+            m_tsa[core] = ((m_tsa[core] & 0xF0000u) | value) & AddressMask;
+            reg(offset) = value;
+            return;
+        case kRegStd:
+            writeStd(core, value);
+            return;
+        case kRegEndxLo:
+            m_endx[core] &= 0xFF0000u;
+            return;
+        case kRegEndxHi:
+            m_endx[core] &= 0x00FFFFu;
+            return;
+        case kRegAttr:
+            if (((value ^ regv(offset)) & 0x40u) != 0u)
+                SPU_LOG("ATTR c%d irqEnable=%d irqa=0x%x\n", core, (value & 0x40u) ? 1 : 0, irqAddress(core));
+            reg(offset) = value;
+            // Re-arming IRQ enable does not replay a stale match; nothing else to do.
+            return;
+        default:
+            break;
+        }
+
+        reg(offset) = value;
+
+        if (local >= 0x1C0u && local < 0x1C0u + Voices * 0xCu)
+        {
+            const uint32_t rel = local - 0x1C0u;
+            Voice &v = m_voices[core][rel / 0xCu];
+            const uint32_t field = rel % 0xCu;
+            const uint32_t base = core * 0x400u + 0x1C0u + (rel / 0xCu) * 0xCu;
+            if (field == kVoiceLsax || field == kVoiceLsax + 2u)
+            {
+                v.lsax = readAddr(base + kVoiceLsax);
+                v.lsaxWritten = true;
+            }
+            else if (field == kVoiceNax || field == kVoiceNax + 2u)
+            {
+                v.nax = readAddr(base + kVoiceNax) & ~(kBlockHalfwords - 1u);
+            }
+        }
+    }
+
+    void IopSpu2::writeStd(int core, uint16_t value)
+    {
+        // Manual (IO) transfer: each STD write stores one halfword at TSA and advances it.
+        testIrq(core, m_tsa[core], 1u);
+        m_ram[m_tsa[core]] = value;
+        m_tsa[core] = (m_tsa[core] + 1u) & AddressMask;
+    }
+
+    void IopSpu2::dmaTransfer(int core, uint8_t *iopRam, uint32_t iopRamSize, uint32_t madr, uint32_t bytes, bool toSpu)
+    {
+        SPU_LOG("DMA c%d %s madr=0x%x bytes=0x%x tsa=0x%x\n", core, toSpu ? "->spu" : "<-spu", madr, bytes, m_tsa[core]);
+        madr &= 0x1FFFFFu;
+        const uint32_t halfwords = bytes / 2u;
+        testIrq(core, m_tsa[core], halfwords);
+        for (uint32_t i = 0; i < halfwords; ++i)
+        {
+            const uint32_t src = madr + i * 2u;
+            if (src + 1u >= iopRamSize)
+                break;
+            uint16_t &cell = m_ram[(m_tsa[core] + i) & AddressMask];
+            if (toSpu)
+                std::memcpy(&cell, iopRam + src, sizeof(cell));
+            else
+                std::memcpy(iopRam + src, &cell, sizeof(cell));
+        }
+        m_tsa[core] = (m_tsa[core] + halfwords) & AddressMask;
+    }
+
+    void IopSpu2::keyOn(int core, int vi)
+    {
+        Voice &v = m_voices[core][vi];
+        const uint32_t base = core * 0x400u + 0x1C0u + vi * 0xCu;
+        SPU_LOG("KON c%d v%d ssa=0x%x pitch=0x%x irqa=0x%x irqEn=%d\n", core, vi, readAddr(base + kVoiceSsa),
+                regv(core * 0x400u + vi * 0x10u + kVoicePitch), irqAddress(core), irqEnabled(core) ? 1 : 0);
+        v.on = true;
+        v.nax = readAddr(base + kVoiceSsa) & ~(kBlockHalfwords - 1u);
+        v.lsax = readAddr(base + kVoiceLsax);
+        v.lsaxWritten = false;
+        v.counter = 0u;
+        v.blockEntered = false;
+        v.phase = Voice::Phase::Attack;
+        v.env = 0;
+        v.envCounter = 0;
+        m_endx[core] &= ~(1u << vi);
+    }
+
+    void IopSpu2::keyOff(int core, int vi)
+    {
+        Voice &v = m_voices[core][vi];
+        if (v.phase != Voice::Phase::Off)
+        {
+            v.phase = Voice::Phase::Release;
+            v.envCounter = 0;
+        }
+    }
+
+    void IopSpu2::raiseIrq(int core)
+    {
+        SPU_LOG("IRQ core%d irqa=0x%x\n", core, irqAddress(core));
+        m_irqInfo |= static_cast<uint16_t>(4u << core);
+        m_irqPending = true;
+    }
+
+    void IopSpu2::testIrq(int accessCore, uint32_t address, uint32_t length)
+    {
+        (void)accessCore;
+        if (length == 0u)
+            return;
+        for (int core = 0; core < 2; ++core)
+        {
+            if (!irqEnabled(core))
+                continue;
+            const uint32_t irqa = irqAddress(core);
+            const uint32_t distance = (irqa - address) & AddressMask;
+            if (distance < length)
+                raiseIrq(core);
+        }
+    }
+
+    void IopSpu2::enterBlock(int core, int vi)
+    {
+        Voice &v = m_voices[core][vi];
+        const uint16_t header = m_ram[v.nax & AddressMask];
+        const uint8_t flags = static_cast<uint8_t>(header >> 8u);
+        if ((flags & 0x4u) != 0u && !v.lsaxWritten)
+            v.lsax = v.nax;
+        testIrq(core, v.nax, kBlockHalfwords);
+        v.blockEntered = true;
+    }
+
+    void IopSpu2::stepEnvelope(int core, int vi)
+    {
+        Voice &v = m_voices[core][vi];
+        const uint32_t regBase = core * 0x400u + vi * 0x10u;
+        const uint16_t adsr1 = regv(regBase + kVoiceAdsr1);
+        const uint16_t adsr2 = regv(regBase + kVoiceAdsr2);
+
+        EnvRate rate{};
+        int32_t target = 0;
+        switch (v.phase)
+        {
+        case Voice::Phase::Off:
+            v.env = 0;
+            return;
+        case Voice::Phase::Attack:
+            rate = makeRate((adsr1 >> 8u) & 0x7Fu, false, (adsr1 & 0x8000u) != 0u);
+            target = kEnvMax;
+            break;
+        case Voice::Phase::Decay:
+            rate = makeRate(((adsr1 >> 4u) & 0xFu) << 2u, true, true);
+            target = std::min<int32_t>(kEnvMax, ((adsr1 & 0xFu) + 1) * 0x800);
+            break;
+        case Voice::Phase::Sustain:
+            rate = makeRate((adsr2 >> 6u) & 0x7Fu, (adsr2 & 0x4000u) != 0u, (adsr2 & 0x8000u) != 0u);
+            break;
+        case Voice::Phase::Release:
+            rate = makeRate((adsr2 & 0x1Fu) << 2u, true, (adsr2 & 0x20u) != 0u);
+            break;
+        }
+
+        int32_t cycles = 1 << std::max(0, rate.shift - 11);
+        int32_t step = rate.step << std::max(0, 11 - rate.shift);
+        if (rate.exponential && !rate.decrease && v.env > 0x6000)
+            cycles *= 4;
+        if (rate.exponential && rate.decrease)
+            step = (step * v.env) >> 15;
+
+        if (++v.envCounter >= cycles)
+        {
+            v.envCounter = 0;
+            v.env = std::clamp(v.env + step, 0, kEnvMax);
+        }
+
+        switch (v.phase)
+        {
+        case Voice::Phase::Attack:
+            if (v.env >= target)
+            {
+                v.env = kEnvMax;
+                v.phase = Voice::Phase::Decay;
+                v.envCounter = 0;
+            }
+            break;
+        case Voice::Phase::Decay:
+            if (v.env <= target)
+            {
+                v.phase = Voice::Phase::Sustain;
+                v.envCounter = 0;
+            }
+            break;
+        case Voice::Phase::Release:
+            if (v.env <= 0)
+            {
+                v.env = 0;
+                v.phase = Voice::Phase::Off;
+            }
+            break;
+        default:
+            break;
+        }
+    }
+
+    void IopSpu2::stepVoice(int core, int vi)
+    {
+        Voice &v = m_voices[core][vi];
+        if (!v.on)
+            return;
+        if (!v.blockEntered)
+            enterBlock(core, vi);
+
+        const uint32_t pitch = std::min<uint32_t>(regv(core * 0x400u + vi * 0x10u + kVoicePitch), 0x3FFFu);
+        v.counter += pitch;
+        while (v.counter >= (kSamplesPerBlock << 12u))
+        {
+            v.counter -= kSamplesPerBlock << 12u;
+            const uint8_t flags = static_cast<uint8_t>(m_ram[v.nax & AddressMask] >> 8u);
+            if ((flags & 0x1u) != 0u)
+            {
+                m_endx[core] |= 1u << vi;
+                if ((flags & 0x2u) != 0u)
+                {
+                    v.nax = v.lsax & ~(kBlockHalfwords - 1u);
+                }
+                else
+                {
+                    // Loop end without repeat: the voice is muted and stops fetching.
+                    v.on = false;
+                    v.phase = Voice::Phase::Off;
+                    v.env = 0;
+                    return;
+                }
+            }
+            else
+            {
+                v.nax = (v.nax + kBlockHalfwords) & AddressMask;
+            }
+            enterBlock(core, vi);
+        }
+        stepEnvelope(core, vi);
+    }
+
+    void IopSpu2::stepOutputAreas()
+    {
+        // Every output sample each core writes its voice-1/voice-3 capture and its
+        // dry/wet L/R mix into fixed 0x200-halfword ring areas of sound RAM. Those
+        // writes are sound-RAM accesses, so they are tested against IRQA like any
+        // other access; drivers arm IRQA inside these areas to get a periodic tick.
+        static constexpr uint32_t kCore0Areas[] = {0x400u, 0x600u, 0x1000u, 0x1200u, 0x1400u, 0x1600u};
+        static constexpr uint32_t kCore1Areas[] = {0xC00u, 0xE00u, 0x1800u, 0x1A00u, 0x1C00u, 0x1E00u};
+        for (uint32_t area : kCore0Areas)
+            testIrq(0, area + m_outPos, 1u);
+        for (uint32_t area : kCore1Areas)
+            testIrq(1, area + m_outPos, 1u);
+        m_outPos = (m_outPos + 1u) & 0x1FFu;
+    }
+
+    void IopSpu2::advanceTo(uint64_t cycle)
+    {
+        if (cycle <= m_lastCycle)
+            return;
+        m_cycleCarry += cycle - m_lastCycle;
+        m_lastCycle = cycle;
+        // Bound catch-up work if the scheduler jumped a long idle period.
+        uint64_t samples = m_cycleCarry / CyclesPerSample;
+        m_cycleCarry %= CyclesPerSample;
+        samples = std::min<uint64_t>(samples, 48000u);
+        for (uint64_t s = 0; s < samples; ++s)
+        {
+            for (int core = 0; core < 2; ++core)
+                for (int vi = 0; vi < Voices; ++vi)
+                    stepVoice(core, vi);
+            stepOutputAreas();
+        }
+    }
+
+    uint64_t IopSpu2::nextEventCycle(uint64_t fallback) const noexcept
+    {
+        // Output areas are written every sample, so an armed IRQA inside them fires within
+        // one ring period; wake the scheduler at that granularity when any IRQ is enabled.
+        if (irqEnabled(0) || irqEnabled(1))
+        {
+            uint64_t soonest = UINT64_MAX;
+            for (int core = 0; core < 2; ++core)
+            {
+                if (!irqEnabled(core))
+                    continue;
+                const uint32_t irqa = irqAddress(core);
+                const uint32_t rel = irqa & 0x1FFu;
+                const uint32_t samplesAhead = ((rel - m_outPos) & 0x1FFu) + 1u;
+                soonest = std::min<uint64_t>(soonest, samplesAhead);
+            }
+            if (soonest != UINT64_MAX)
+                fallback = std::min<uint64_t>(fallback, m_lastCycle + soonest * CyclesPerSample);
+        }
+        for (const auto &core : m_voices)
+            for (const Voice &v : core)
+                if (v.on)
+                    return std::min<uint64_t>(fallback, m_lastCycle + CyclesPerSample * kSamplesPerBlock);
+        return fallback;
+    }
+}
diff --git a/ps2xIOP/src/emulator/core/iop_spu2.h b/ps2xIOP/src/emulator/core/iop_spu2.h
new file mode 100644
index 0000000..ae969ca
--- /dev/null
+++ b/ps2xIOP/src/emulator/core/iop_spu2.h
@@ -0,0 +1,103 @@
+#pragma once
+// SPU2 core model for the ps2xIOP emulator.
+//
+// Scope: what IOP-side sound drivers (sony LIBSD.IRX and anything built on it,
+// e.g. RenderWare Audio's RWA.IRX) observe from the hardware:
+//   - 2 MiB sound RAM and the 16-bit register file (both cores, 0x1F900000-0x1F9007FF)
+//   - manual (IO) and DMA transfers into/out of sound RAM through TSA/STD
+//   - voice playback bookkeeping: KON/KOFF, pitch-driven NAX progression over
+//     ADPCM blocks, loop start/end/repeat flags, LSAX, ENDX
+//   - the address-match interrupt (IRQA) raised by voice fetches and transfers,
+//     reported through SPDIF_IRQINFO and delivered as IOP interrupt 9
+//   - ADSR envelope (PS1/PS2 SPU rate tables) so ENVX reads are meaningful
+//
+// Audio sample output is not produced here yet (decoded mixing is a separate step).
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+namespace ps2x::iop::detail
+{
+    class IopSpu2
+    {
+    public:
+        static constexpr uint32_t RegBase = 0x1F900000u;
+        static constexpr uint32_t RegSize = 0x800u;
+        static constexpr uint32_t RamHalfwords = 1u << 20; // 2 MiB
+        static constexpr uint32_t AddressMask = RamHalfwords - 1u;
+        static constexpr int Voices = 24;
+        static constexpr int Irq = 9;               // IOP_IRQ_SPU
+        static constexpr uint64_t CyclesPerSample = 768u; // 36.864 MHz / 48 kHz
+
+        IopSpu2();
+        void reset();
+
+        [[nodiscard]] static bool isRegister(uint32_t phys) noexcept
+        {
+            return phys >= RegBase && phys < RegBase + RegSize;
+        }
+        [[nodiscard]] uint16_t read16(uint32_t phys);
+        void write16(uint32_t phys, uint16_t value);
+
+        // DMA channel 4 (core 0) / 7 (core 1). toSpu = IOP RAM -> sound RAM.
+        void dmaTransfer(int core, uint8_t *iopRam, uint32_t iopRamSize, uint32_t madr, uint32_t bytes, bool toSpu);
+
+        // Advance voice playback up to the given IOP cycle.
+        void advanceTo(uint64_t cycle);
+        [[nodiscard]] bool takeIrq() noexcept
+        {
+            const bool pending = m_irqPending;
+            m_irqPending = false;
+            return pending;
+        }
+        void markDmaComplete(int core) { reg(core * 0x400u + 0x344u) |= 0x80u; }
+        // Upper bound for how far the scheduler may idle before the SPU must be stepped again.
+        [[nodiscard]] uint64_t nextEventCycle(uint64_t fallback) const noexcept;
+
+    private:
+        struct Voice
+        {
+            bool on = false;
+            uint32_t nax = 0;       // current block address (halfwords, 8-aligned)
+            uint32_t lsax = 0;
+            bool lsaxWritten = false;
+            uint32_t counter = 0;   // 12.12 fixed-point sample position inside the block
+            bool blockEntered = false;
+            // ADSR
+            enum class Phase : uint8_t { Off, Attack, Decay, Sustain, Release } phase = Phase::Off;
+            int32_t env = 0;
+            int32_t envCounter = 0;
+        };
+
+        [[nodiscard]] uint16_t &reg(uint32_t offset) { return m_regs[(offset & (RegSize - 1u)) >> 1]; }
+        [[nodiscard]] uint16_t regv(uint32_t offset) const { return m_regs[(offset & (RegSize - 1u)) >> 1]; }
+        [[nodiscard]] uint32_t readAddr(uint32_t hiOffset) const;
+        void writeAddr(uint32_t hiOffset, uint32_t value);
+        [[nodiscard]] uint32_t voiceAddrBase(int core, int v) const { return core * 0x400u + 0x1C0u + v * 0xCu; }
+        [[nodiscard]] uint32_t voiceRegBase(int core, int v) const { return core * 0x400u + v * 0x10u; }
+        [[nodiscard]] bool irqEnabled(int core) const { return (regv(core * 0x400u + 0x19Au) & 0x40u) != 0u; }
+        [[nodiscard]] uint32_t irqAddress(int core) const { return readAddr(core * 0x400u + 0x19Cu); }
+
