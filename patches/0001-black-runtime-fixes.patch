+    // A queued LSU store becomes visible at the next cycle boundary, before
+    // anything else can read VU memory; writing it at once is equivalent.
+    // Same masked merge as commitReadyPipelines().
+    inline void vuDirectStore(uint8_t *data, uint32_t dataSize, uint32_t address, const uint32_t words[4], uint8_t laneMask)
+    {
+        if (!data || address + 16u > dataSize)
+            return;
+        uint32_t merged[4];
+        std::memcpy(merged, data + address, sizeof(merged));
+        if (laneMask & 0x8u) merged[0] = words[0];
+        if (laneMask & 0x4u) merged[1] = words[1];
+        if (laneMask & 0x2u) merged[2] = words[2];
+        if (laneMask & 0x1u) merged[3] = words[3];
+        std::memcpy(data + address, merged, sizeof(merged));
+    }
+}
