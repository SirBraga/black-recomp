+// The PATH1 transfer of an XGKICK takes a qword of VU memory every two cycles. The fast engines do not
+// step it cycle by cycle: it is brought up to the current cycle before anything that could tell the
+// difference (a store to VU memory, the next XGKICK, the end of a run).
+inline __attribute__((always_inline)) void VU1Interpreter::syncXgkick()
+{
+    if (__builtin_expect(m_xgkick.active, 0))
+        syncXgkickSlow();
+}
