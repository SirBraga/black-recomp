+        }
+    }
+#else
+    (void)fzActive;
+#endif
+    const auto operand = [](float value)
+    {
+        uint32_t bits;
+        std::memcpy(&bits, &value, sizeof(bits));
+        if ((bits & 0x7F800000u) == 0u)
+            bits &= 0x80000000u;
