+void PS2Runtime::excludeAsyncCallbackStackRange(uint32_t begin, uint32_t end)
+{
+    begin &= PS2_RAM_MASK;
+    end = std::min(end, PS2_RAM_SIZE);
+    if (end <= begin)
+    {
+        return;
+    }
