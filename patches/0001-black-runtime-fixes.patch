+        DmaRequest &dmaOut = m_dma[1];
+        uint32_t inCursor = dmaIn.addr;
+        uint32_t inEnd = dmaIn.armed ? dmaIn.addr + dmaIn.blockWords * 4u * dmaIn.blocks : dmaIn.addr;
