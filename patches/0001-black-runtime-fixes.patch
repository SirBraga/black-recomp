+    m_hotDecodedRgba[static_cast<size_t>(level)] = hit->rgba.empty() ? nullptr : hit->rgba.data();
+    m_hotDecodedIdx[static_cast<size_t>(level)] = hit->indices.empty() ? nullptr : hit->indices.data();
+}
